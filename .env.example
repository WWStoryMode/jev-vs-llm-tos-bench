# Copy to .env and fill in. .env is gitignored.
OPENROUTER_API_KEY=sk-or-...
JEV_MODEL=typesafe/jev-1.13
# Any Claude model ID from https://openrouter.ai/models
LLM_MODEL=anthropic/claude-sonnet-5.5
# Optional: model for the UI's "Why?" explanations and scripts/reexplain.ts (default anthropic/claude-haiku-5.5)
# EXPLAIN_MODEL=anthropic/claude-sonnet-5.5
# Optional: models the UI may switch between for "Why?" (comma-separated; the browser can't pick any other)
# EXPLAIN_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5
